<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project default="Build all" name="FskEncoder">

	<include file="../Build_Support.xml" />
	
	<property name="targetName" 		value="${ant.project.name}" />

	<property name="stream"				value="0"/>
	
	<property name="dir.scriptsRepo"	value="${dir.defaultsRepo}/${targetName}/scripts" />
	<property name="dir.configRepo"		value="${dir.defaultsRepo}/${targetName}/cfg" />
	<property name="dir.classesRoot"	value="${dir.projectRoot}/target/classes" />

	
	<buildnumber file="${dir.defaultsRepo}/${targetName}/build.number"/>
	
	<property name="version"	value="${main.line}.${stream}"/>
	<property name="build"		value="${build.number}" />
	<property name="release"	value ="${version}.${build}" />

	
	<target name="Build all">
		
		<tstamp>
			<format property="current.time" pattern="yyyy.MM.dd HH:mm:ss" />
		</tstamp>

		<echo message="Building version ${release} at ${current.time}" />      
		
		<antcall target="Clean" />
		<antcall target="Create Jar" />				
		<antcall target="Copy config" />

	</target>
	
	
	<target name="Clean" description="Deletes ALL files and folders in the 'dist' directory" >
		
		<delete file="${dir.dist.bin}/${targetName}.jar"		failonerror="no" />

		<delete file="${dir.dist.bin}/${targetName}.bat"		failonerror="no" />
		<delete file="${dir.dist.bin}/${targetName}-all.bat"	failonerror="no" />

		<delete file="${dir.dist.bin}/miglayout-3.7.4.jar"		failonerror="no" />
		<delete file="${dir.dist.bin}/log4j-api-2.11.2.jar"		failonerror="no" />
		<delete file="${dir.dist.bin}/log4j-core-2.11.2.jar"	failonerror="no" />
		<delete file="${dir.dist.bin}/args4j-2.37.jar"			failonerror="no" />

		<delete file="${dir.dist.cfg}/Plugin.properties"		failonerror="no" />
		<delete file="${dir.dist.cfg}/FskEncoder.properties"	failonerror="no" />
		<delete file="${dir.dist.cfg}/log4j2.xml"				failonerror="no" />
		
	</target>
	

	<target name="Create Jar">
		
		<echo message="release: ${release}" />
		
		<replaceFile sourcepath="${dir.scriptsRepo}" destPath="${dir.dist}/bin/" fileName="${targetName}.bat" />
		<replaceFile sourcepath="${dir.scriptsRepo}" destPath="${dir.dist}/bin/" fileName="${targetName}-all.bat" />

		<mkManifest 
			location="${dir.defaultsRepo}/${targetName}" 
			version="${release}" 
			timestamp="${current.time}" 
		/>
		
		<delete file="${dir.dist.bin}/${targetName}.jar" failonerror="no" />
		
        <jar destfile="${dir.dist.bin}/${targetName}.jar"
			basedir="${dir.classesRoot}"
			excludes="source/**/* target/**/*"
			manifest="${dir.defaultsRepo}/${targetName}/MANIFEST.MF"
    		>
        	
        </jar>

		<replaceLibrary sourcepath="${dir.mavenRepo}/com/miglayout/miglayout/3.7.4/"				fileName="miglayout-3.7.4.jar"/>
		<replaceLibrary sourcepath="${dir.mavenRepo}/org/apache/logging/log4j/log4j-api/2.11.2/"	fileName="log4j-api-2.11.2.jar"/>
		<replaceLibrary sourcepath="${dir.mavenRepo}/org/apache/logging/log4j/log4j-core/2.11.2/"	fileName="log4j-core-2.11.2.jar"/>
		<replaceLibrary sourcepath="${dir.mavenRepo}/args4j/args4j/2.37/"							fileName="args4j-2.37.jar"/>

	</target>
	
	
	<target name="Copy config" >
		
		<echo message="release: ${release}" />

		<replaceConfig sourcePath="${dir.configRepo}" fileName="Plugin.properties" />
		<replaceConfig sourcePath="${dir.configRepo}" fileName="FskEncoder.properties" />
		<replaceConfig sourcePath="${dir.configRepo}" fileName="log4j2.xml" />

	</target>
	
	
</project>
