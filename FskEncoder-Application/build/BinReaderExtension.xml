<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project default="Build all" name="BinReaderExtension">

	<include file="../Build_Support.xml" />
	
	<property name="targetName" 		value="${ant.project.name}" />
	<property name="stream"				value="0"/>
	
	<property name="dir.scriptsRepo"	value="${dir.defaultsRepo}/${targetName}" />
	<property name="dir.configRepo"		value="${dir.defaultsRepo}/${targetName}" />
	<property name="dir.classesRoot"	value="${dir.projectRoot}/target/classes" />

	
	<buildnumber file="${dir.defaultsRepo}/${targetName}/build.number"/>
	
	<property name="version"	value="${main.line}.${stream}"/>
	<property name="build"		value="${build.number}" />
	<property name="release"	value ="${version}.${build}" />

	
	<target name="Build all">
		
		<tstamp>
			<format property="current.time" pattern="yyyy.MM.dd HH:mm:ss" />
		</tstamp>

		<echo message="Building version ${release} at ${current.time}" />      
		
		<antcall target="Clean" />
		<antcall target="Create Jar" />				
		<antcall target="Copy config" />

	</target>
	
	
	<target name="Clean" description="Deletes ALL files and folders in the 'dist' directory" >
		
		<delete file="${dir.dist.extensions}/${targetName}.jar" 				failonerror="no" />

		<delete file="${dir.dist.extensions}/${targetName}.bat"					failonerror="no" />
		<delete file="${dir.dist.extensions}${targetName}.properties"			failonerror="no" />
		
	</target>
	

	<target name="Create Jar">
		
		<echo message="release: ${release}" />
		
		<replaceFile sourcepath="${dir.scriptsRepo}" destPath="${dir.dist.extensions}/" fileName="${targetName}.bat" />

		<mkManifest 
			location="${dir.defaultsRepo}/${targetName}" 
			version="${release}" 
			timestamp="${current.time}" 
		/>
		
		<delete file="${dir.dist.extensions}/${targetName}.jar" failonerror="no" />
		
        <jar destfile="${dir.dist.extensions}/${targetName}.jar"
			basedir="${dir.classesRoot}"
			includes="source/bin/**/*"
			manifest="${dir.defaultsRepo}/${targetName}/MANIFEST.MF"
    		>
        	
        </jar>

	</target>
	
	
	<target name="Copy config" >
		
		<echo message="release: ${release}" />

		<replaceFile sourcepath="${dir.scriptsRepo}" destPath="${dir.dist.extensions}/" fileName="${targetName}.bat" />
		<replaceFile sourcepath="${dir.configRepo}"  destPath="${dir.dist.extensions}/" fileName="${targetName}.properties" />

	</target>
	
	
</project>
